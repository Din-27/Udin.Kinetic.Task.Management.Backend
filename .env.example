PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
NEXTAUTH_SECRET="kinetic-secret-key-google-sso-32-chars-long"

# Database Connection (Neon Tech PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Web Push Notification VAPID Credentials
NEXT_VAPID_PUBLIC_KEY="your-vapid-public-key"
NEXT_VAPID_PRIVATE_KEY="your-vapid-private-key"

# S3 File Storage (AWS S3 or Neon Object Storage)
AWS_ENDPOINT_URL_S3="https://your-s3-endpoint.aws.neon.tech"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="default"

# RAG & AI Configuration (Google Gemini / pgvector)
GEMINI_API_KEY="your-gemini-api-key"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION="768"
LLM_MODEL="gemini-3.8-flash"
